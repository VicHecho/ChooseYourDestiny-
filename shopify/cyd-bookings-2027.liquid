};

var avail={days:JSON.parse(JSON.stringify(DEFAULT_AVAIL)),blocked:[],tz:'Eastern Time (ET)'};
var step=0,b={},month=0;
var $=function(s,r){return (r||document).querySelector(s)};
var body=$('#cyd-body'),stepsEl=$('#cyd-steps');
var STEPS=['Session','Date','Time','Your details'];

function esc(v){return String(v==null?'':v).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;')}
function load(){try{return JSON.parse(localStorage.getItem(KEY))||[]}catch(e){return []}}
function save(r){try{localStorage.setItem(KEY,JSON.stringify(r))}catch(e){alert('Could not save to this device: '+e.message)}}
function loadAvail(){try{var v=JSON.parse(localStorage.getItem(AKEY));if(v&&v.days)avail=v}catch(e){}}
function saveDraft(){try{localStorage.setItem(DKEY,JSON.stringify({step:step,b:b,month:month}))}catch(e){}}
function loadDraft(){try{var v=JSON.parse(localStorage.getItem(DKEY));if(v&&v.b){b=v.b;step=v.step||0;month=v.month||0}}catch(e){}}
function dl(name,text,type){var bl=new Blob([text],{type:type||'application/json'}),u=URL.createObjectURL(bl),a=document.createElement('a');a.href=u;a.download=name;document.body.appendChild(a);a.click();a.remove();setTimeout(function(){URL.revokeObjectURL(u)},2000)}
function slug(s){return String(s||'client').toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'').slice(0,40)||'client'}
function pad(n){return String(n).padStart(2,'0')}
function iso(y,m,day){return y+'-'+pad(m+1)+'-'+pad(day)}
function pretty(dstr){var p=dstr.split('-'),dt=new Date(+p[0],+p[1]-1,+p[2]);return DOW[dt.getDay()]+', '+MONTHS[dt.getMonth()]+' '+(+p[2])+', '+p[0]}
function pretty12(t){var p=t.split(':'),h=+p[0],ap=h>=12?'pm':'am',h12=h%12===0?12:h%12;return h12+(p[1]==='00'?'':':'+p[1])+' '+ap}
function endTime(t,mins){var p=t.split(':'),tot=(+p[0])*60+(+p[1])+mins;return pad(Math.floor(tot/60)%24)+':'+pad(tot%60)}
function takenKeys(){var o={};if(MODE==='advisor')load().forEach(function(r){if(r.status!=='cancelled')o[r.date+' '+r.time]=1});return o}

/* ---- render ---- */
function renderSteps(){stepsEl.innerHTML=STEPS.map(function(s,i){return '<div class="'+(i===step?'on':(i<step?'done':''))+'">'+(i+1)+'. '+s+'</div>'}).join('')}

function render(){
  renderSteps();
  if(step===0){
    var svc=SERVICES.map(function(s,i){return '<button type="button" class="cyd-pick'+(b.service===s.name?' sel':'')+'" data-svc="'+i+'"><b>'+esc(s.name)+'</b><span>'+esc(s.note)+'</span></button>'}).join('');
    var cur=SERVICES.filter(function(s){return s.name===b.service})[0];
    var dur=cur?'<div class="cyd-f full" data-f="duration" style="margin-top:32px"><label>How long <span class="req">*</span><div class="hint">Sessions often run over. That extra time is donated, not billed. '+esc(promoLine())+'</div></label><div class="cyd-slots" style="margin-top:0">'+cur.durations.map(function(m){var r=RATES[m];return '<button type="button" class="cyd-slot cyd-rate'+(b.duration===m?' sel':'')+'" data-dur="'+m+'"><b>'+m+' min</b><span>'+money(r.now)+'</span><small>regularly '+money(r.was)+'</small></button>'}).join('')+'</div></div>':'';
    body.innerHTML='<h2 class="cyd-h">Let\u2019s find your time in 2027.</h2><p class="cyd-sub">Choose what you would like to book. Every session runs on '+esc(avail.tz)+'.</p>'+
      '<div class="cyd-f full" data-f="service"><div class="cyd-picks">'+svc+'</div></div>'+dur+
      '<div class="cyd-actions"><span class="cyd-spacer"></span><button class="cyd-btn" data-go="1">Continue</button></div>';
  }
  if(step===1)body.innerHTML='<h2 class="cyd-h">Pick a date.</h2><p class="cyd-sub">Open days are shown in white with the number of windows left. Move through the year with the arrows.</p>'+
    '<div class="cyd-f full" data-f="date">'+calendarHTML()+'</div>'+
    '<div class="cyd-legendrow">'+TIERS.map(function(tier){return '<span><i style="background:'+tier.color+'"></i> '+tier.label+' \u00b7 '+tier.window+'</span>'}).join('')+'<span><i style="background:var(--paper-100)"></i> Closed or full</span></div>'+
    '<p class="cyd-sub" style="font-size:13px;margin-top:10px">Limited and after-hours availability and fees may vary.</p>'+
    '<div class="cyd-actions"><button class="cyd-btn ghost" data-go="-1">Back</button><span class="cyd-spacer"></span><button class="cyd-btn" data-go="1">Continue</button></div>';
  if(step===2){
    var day=new Date(+b.date.split('-')[0],+b.date.split('-')[1]-1,+b.date.split('-')[2]).getDay();
    var taken=takenKeys();
    var dayslots=avail.days[day]||[];
    var groups=TIERS.map(function(tier){
      var mine=sortInTier(dayslots.filter(function(t){return tierFor(t).key===tier.key}),tier);
      if(!mine.length)return '';
      return '<div class="cyd-tier"><div class="cyd-tierhd"><i style="background:'+tier.color+'"></i><b>'+tier.label+'</b><span>'+tier.window+'</span></div>'+
        (tier.key==='regular'?'':'<p class="cyd-tiernote">'+tier.note+'</p>')+
        '<div class="cyd-slots">'+mine.map(function(t){
          var isTaken=!!taken[b.date+' '+t];
          return '<button type="button" class="cyd-slot'+(b.time===t?' sel':'')+'" data-time="'+t+'"'+(isTaken?' disabled title="Already booked"':'')+'>'+pretty12(t)+'</button>';
        }).join('')+'</div></div>';
    }).join('');
    var slots=groups||'<p class="cyd-sub">No windows left on this day.</p>';
    body.innerHTML='<h2 class="cyd-h">'+esc(pretty(b.date))+'</h2><p class="cyd-sub">'+esc(b.duration)+' minutes for '+esc(b.service)+'. Times are '+esc(avail.tz)+'. Regular hours run at standard rates; limited and after-hours windows may vary in both availability and fee.</p>'+
      '<div class="cyd-f full" data-f="time"><div class="cyd-slots">'+slots+'</div></div>'+
      (MODE==='public'?'<div class="cyd-note">Times shown are my usual windows. I will confirm your slot by email, or offer the nearest alternative if someone reached it first.</div>':'')+
      '<div class="cyd-actions"><button class="cyd-btn ghost" data-go="-1">Back</button><span class="cyd-spacer"></span><button class="cyd-btn" data-go="1">Continue</button></div>';
  }
  if(step===3)body.innerHTML='<h2 class="cyd-h">Where should I reach you?</h2><p class="cyd-sub">'+esc(pretty(b.date))+' at '+esc(pretty12(b.time))+', '+esc(b.duration)+' minutes.</p>'+
    '<div class="cyd-grid">'+
    field('name','Full name','<input id="f_name" type="text" value="'+esc(b.name)+'" placeholder="Your name">','',1)+
    field('email','Email','<input id="f_email" type="email" value="'+esc(b.email)+'" placeholder="you@example.com">','',1)+
    field('phone','Phone','<input id="f_phone" type="tel" value="'+esc(b.phone)+'">','',0)+
    field('firsttime','Have we worked together before?','<select id="f_firsttime"><option value="">Select\u2026</option>'+['This is my first session','I am a returning client'].map(function(o){return '<option'+(b.firsttime===o?' selected':'')+'>'+o+'</option>'}).join('')+'</select>','',0)+
    field('notes','Anything I should know before we meet','<textarea id="f_notes" placeholder="Optional. What you would like to focus on, or anything affecting timing.">'+esc(b.notes)+'</textarea>','',0)+
    '</div>'+
    '<label class="cyd-upsell"><input type="checkbox" id="c_book"'+(b.book?' checked':'')+'><span><b>Add the <i>Metaphysical Dayplanner \u2014 Hack The Matrix 2026</i>, Deluxe Edition \u2014 $49.99</b>Paperback copy, early access to the digital edition, and a limited edition Choose Your Destiny tote while supplies last. Tick this and I will add it to your invoice.</span></label>'+
    reviewHTML()+
    '<div class="cyd-note">'+(MODE==='advisor'?'Choosing a time here holds it for you.':'Choosing a time here sends me your request.')+' I will confirm the date with you by phone or email before our session.</div>'+
    '<div class="cyd-actions"><button class="cyd-btn ghost" data-go="-1">Back</button><span class="cyd-spacer"></span><button class="cyd-btn dark" id="confirm">'+(MODE==='advisor'?'Confirm booking':'Request this time')+'</button></div>';
  if(step===4){
    var msg=MODE==='advisor'
      ? 'Your session is on my calendar. I will confirm the date with you by phone or email before we meet. Add it to your own calendar with the button below.'
      : (SUBMIT_ENDPOINT&&!b.deliveryFailed
          ? 'Your request has been sent. I will confirm the date with you by phone or email at <b>'+esc(b.email)+'</b> before anything is final.'
          : 'Your request is ready to send. <b>Please press the email button below</b> so it reaches me \u2014 I will then confirm the date with you by phone or email at <b>'+esc(b.email)+'</b>.');
    body.innerHTML='<div class="cyd-done"><div class="mark">&#10003;</div><h2 class="cyd-h">'+(MODE==='advisor'?'You\u2019re booked.':'Almost there.')+'</h2>'+
      '<div class="cyd-when">'+esc(pretty(b.date))+'<br>'+esc(pretty12(b.time))+' \u2013 '+esc(pretty12(endTime(b.time,b.duration)))+' '+esc(avail.tz)+'</div>'+
      '<p class="cyd-sub" style="margin:0 auto">'+msg+'</p>'+
      '<div class="cyd-actions" style="justify-content:center">'+
      (MODE==='public'&&(!SUBMIT_ENDPOINT||b.deliveryFailed)?'<a class="cyd-btn" style="text-decoration:none" href="'+mailtoLink(b)+'">Email my request</a>':'')+
      '<button class="cyd-btn'+(MODE==='public'&&(!SUBMIT_ENDPOINT||b.deliveryFailed)?' ghost':'')+'" id="ics">Add to my calendar</button>'+
      (MODE==='advisor'?'<button class="cyd-btn ghost" id="again">Book another session</button>':'')+
      '</div>'+
      (b.time&&tierFor(b.time).key!=='regular'?'<div class="cyd-note warn" style="text-align:left;max-width:62ch;margin:32px auto 0">Your session falls in <b>'+esc(tierFor(b.time).label.toLowerCase())+'</b> ('+esc(tierFor(b.time).window)+'). Availability and fees for these hours may vary \u2014 I will confirm both with you before the session.</div>':'')+
      '<div class="cyd-note" style="text-align:left;max-width:62ch;margin:32px auto 0">Please read and sign the client intake and consultation agreement before our first session. <a href="'+INTAKE_URL+'">Open the intake form</a>.</div>'+
      '</div>';
  }
  wire();window.scrollTo(0,0);
}

function field(id,label,html,hint,req){return '<div class="cyd-f'+(id==='notes'?' full':'')+'" data-f="'+id+'"><label for="f_'+id+'">'+esc(label)+(req?' <span class="req">*</span>':'')+(hint?'<div class="hint">'+hint+'</div>':'')+'</label>'+html+'</div>'}

function calendarHTML(){
  var first=new Date(YEAR,month,1).getDay(),days=new Date(YEAR,month+1,0).getDate(),taken=takenKeys();
  var cells='';
  for(var i=0;i<first;i++)cells+='<div class="cyd-day empty"></div>';
  for(var dnum=1;dnum<=days;dnum++){
    var ds=iso(YEAR,month,dnum),dow=new Date(YEAR,month,dnum).getDay();
    var slots=(avail.days[dow]||[]).filter(function(t){return !taken[ds+' '+t]});
    var blocked=avail.blocked.indexOf(ds)>-1;
    var open=!blocked&&slots.length>0;
    var bands=open?TIERS.filter(function(tier){return slots.some(function(t){return tierFor(t).key===tier.key})}):[];
    cells+='<button type="button" class="cyd-day'+(b.date===ds?' sel':'')+'" data-date="'+ds+'"'+(open?'':' disabled')+'>'+dnum+
      (open?'<i>'+slots.length+' open</i><u>'+bands.map(function(tier){return '<s style="background:'+tier.color+'"></s>'}).join('')+'</u>':'<i>\u00a0</i>')+'</button>';
  }
  return '<div class="cyd-monthbar"><button type="button" id="prevm"'+(month===0?' disabled':'')+'>&larr; Prev</button><b>'+MONTHS[month]+' '+YEAR+'</b><button type="button" id="nextm"'+(month===11?' disabled':'')+'>Next &rarr;</button></div>'+
    '<div class="cyd-dow">'+DOW.map(function(d){return '<span>'+d+'</span>'}).join('')+'</div>'+
    '<div class="cyd-cal">'+cells+'</div>';
}

function row(label,val){if(val==null||val==='')return '';return '<div><b>'+esc(label)+'</b><span>'+esc(val)+'</span></div>'}
function reviewHTML(){
  return '<div style="margin-top:32px;font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase">Your booking</div><div class="cyd-review">'+
    row('Session',b.service)+row('Length',b.duration?b.duration+' minutes':'')+
    (b.duration&&RATES[b.duration]?row('Fee',money(RATES[b.duration].now)+'  (regularly '+money(RATES[b.duration].was)+')'):'')+
    (b.book?row('Also sending','Metaphysical Dayplanner \u2014 Hack The Matrix 2026, Deluxe Edition ($49.99)'):'')+
    row('Date',b.date?pretty(b.date):'')+row('Time',b.time?pretty12(b.time)+' \u2013 '+pretty12(endTime(b.time,b.duration))+' '+avail.tz:'')+
    (b.time?row('Rate band',tierFor(b.time).label+' ('+tierFor(b.time).window+')'+(tierFor(b.time).key==='regular'?'':' \u2014 fees may vary')):'')+
  '</div>';
}

function collect(){
  body.querySelectorAll('input[id^=f_],select[id^=f_],textarea[id^=f_]').forEach(function(el){b[el.id.slice(2)]=el.value});
  var bk=body.querySelector('#c_book');if(bk)b.book=bk.checked;
  saveDraft();
}
function flag(id,msg){var f=body.querySelector('[data-f="'+id+'"]');if(!f)return;f.classList.add('bad');if(!f.querySelector('.err')){var e=document.createElement('div');e.className='err';e.textContent=msg;f.appendChild(e)}}
function validate(){
  body.querySelectorAll('.bad').forEach(function(f){f.classList.remove('bad')});
  body.querySelectorAll('.err').forEach(function(e){e.remove()});
  var bad=[];
  if(step===0){if(!b.service){flag('service','Please choose a session type.');bad.push(1)}
    if(!b.duration){flag('duration','Please choose a length.');bad.push(1)}}
  if(step===1&&!b.date){flag('date','Please pick a date.');bad.push(1)}
  if(step===2&&!b.time){flag('time','Please pick a time.');bad.push(1)}
  if(step===3){
    if(!String(b.name||'').trim()){flag('name','Please enter your name.');bad.push(1)}
    if(!String(b.email||'').trim()){flag('email','Please enter your email.');bad.push(1)}
    else if(!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(b.email.trim())){flag('email','That email does not look right.');bad.push(1)}
  }
  return bad.length===0;
}

function confirmBooking(){
  var rec=JSON.parse(JSON.stringify(b));
  rec.id='CYD-BK-'+Date.now().toString(36).toUpperCase();
  rec.createdAt=new Date().toISOString();
  rec.year=YEAR;rec.timezone=avail.tz;rec.status='booked';rec.source=MODE;rec.replied=false;
  rec.endTime=endTime(rec.time,rec.duration);
  rec.fee=RATES[rec.duration]?RATES[rec.duration].now:'';
  rec.book=!!rec.book;
  rec.tier=tierFor(rec.time).key;
  rec.tierLabel=tierFor(rec.time).label;
  if(MODE==='advisor'){
    var taken=takenKeys();
    if(taken[rec.date+' '+rec.time]){alert('That time was just taken. Please choose another.');step=2;render();return}
    var all=load();all.push(rec);all.sort(function(x,y){return (x.date+x.time).localeCompare(y.date+y.time)});save(all);
  }else{
    rec.status='requested';
    /* No backend means the client's own mail app is the only delivery path, so
       open it for them rather than hoping they find the button. The button
       stays on the confirmation screen as a manual retry. */
    if(!SUBMIT_ENDPOINT){setTimeout(function(){try{window.location.href=mailtoLink(rec)}catch(e){}},600)}
    if(SUBMIT_ENDPOINT){
      try{fetch(SUBMIT_ENDPOINT,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(rec)})
        .then(function(r){if(!r.ok)throw new Error('HTTP '+r.status)})
        .catch(function(){b.deliveryFailed=true;render()})}catch(e){b.deliveryFailed=true}
    }
  }
  b=rec;
  try{localStorage.removeItem(DKEY)}catch(e){}
  step=4;render();
}

function mailtoLink(r){
  var L=['Session request \u2014 '+(r.name||''),'',
    'Date: '+(r.date?pretty(r.date):''),'Time: '+(r.time?pretty12(r.time)+' \u2013 '+pretty12(endTime(r.time,r.duration)):'')+' '+avail.tz,
    'Session: '+(r.service||''),'Length: '+(r.duration||'')+' minutes',
    'Fee: '+(RATES[r.duration]?money(RATES[r.duration].now)+' (regularly '+money(RATES[r.duration].was)+')':''),
    'Book requested: '+(r.book?'yes \u2014 Dayplanner Deluxe Edition, $49.99':'no'),
    'Rate band: '+(r.time?tierFor(r.time).label+' ('+tierFor(r.time).window+')':''),'',
    'Name: '+(r.name||''),'Email: '+(r.email||''),'Phone: '+(r.phone||''),'Status: '+(r.firsttime||''),'',
    'Notes: '+(r.notes||'\u2014')];
  return 'mailto:'+ADVISOR_EMAIL+'?subject='+encodeURIComponent('2027 session request \u2014 '+(r.name||''))+'&body='+encodeURIComponent(L.join('\n'));
}

function icsFor(r){
  function stamp(dstr,t){var p=dstr.split('-'),q=t.split(':');return p[0]+p[1]+p[2]+'T'+q[0]+q[1]+'00'}
  return ['BEGIN:VCALENDAR','VERSION:2.0','PRODID:-//Choose Your Destiny//2027 Bookings//EN','BEGIN:VEVENT',
    'UID:'+(r.id||'cyd')+'@chooseyourdestiny.us',
    'DTSTAMP:'+new Date().toISOString().replace(/[-:]/g,'').split('.')[0]+'Z',
    'DTSTART:'+stamp(r.date,r.time),'DTEND:'+stamp(r.date,endTime(r.time,r.duration)),
    'SUMMARY:Choose Your Destiny \u2014 '+(r.service||'Session'),
    'DESCRIPTION:'+(r.duration||'')+' minute session with Vic Hecho. Times are '+avail.tz+'.',
    'ORGANIZER;CN=Choose Your Destiny:mailto:'+ADVISOR_EMAIL,
    'END:VEVENT','END:VCALENDAR'].join('\r\n');
}

function wire(){
  body.querySelectorAll('[data-svc]').forEach(function(btn){btn.addEventListener('click',function(){
    var s=SERVICES[+btn.dataset.svc];b.service=s.name;
    if(s.durations.indexOf(b.duration)<0)b.duration=null;
    saveDraft();render();
  })});
  body.querySelectorAll('[data-dur]').forEach(function(btn){btn.addEventListener('click',function(){b.duration=+btn.dataset.dur;saveDraft();render()})});
  body.querySelectorAll('[data-date]').forEach(function(btn){btn.addEventListener('click',function(){b.date=btn.dataset.date;b.time=null;saveDraft();step=2;render()})});
  body.querySelectorAll('[data-time]').forEach(function(btn){btn.addEventListener('click',function(){b.time=btn.dataset.time;saveDraft();step=3;render()})});
  var pm=body.querySelector('#prevm');if(pm)pm.addEventListener('click',function(){if(month>0){month--;saveDraft();render()}});
  var nm=body.querySelector('#nextm');if(nm)nm.addEventListener('click',function(){if(month<11){month++;saveDraft();render()}});
  body.querySelectorAll('[data-go]').forEach(function(btn){btn.addEventListener('click',function(){
    collect();var dir=+btn.dataset.go;
    if(dir>0&&!validate())return;
    step=Math.max(0,Math.min(4,step+dir));render();
  })});
  body.querySelectorAll('input,select,textarea').forEach(function(el){el.addEventListener('change',collect)});
  var c=body.querySelector('#confirm');if(c)c.addEventListener('click',function(){collect();if(validate())confirmBooking()});
  var ic=body.querySelector('#ics');if(ic)ic.addEventListener('click',function(){dl('cyd-session-'+b.date+'.ics',icsFor(b),'text/calendar')});
  var ag=body.querySelector('#again');if(ag)ag.addEventListener('click',function(){b={};step=0;render()});
}

/* ---- advisor panel (advisor build only) ---- */
var adm=$('#cyd-admin');
function on(sel,ev,fn){var e=$(sel);if(e)e.addEventListener(ev,fn)}
if(MODE!=='advisor'){
  [adm,$('#cyd-advisor'),$('#cyd-file')].forEach(function(e){if(e)e.remove()});
  var fn=$('#cyd-footnote');
  if(fn)fn.textContent='Your request is sent only to Choose Your Destiny. Nothing is stored on this site.';
}

function renderRecords(){
  var all=load(),pending=all.filter(function(r){return !r.replied}).length;
  $('#cyd-count').textContent=all.length+' booking'+(all.length===1?'':'s')+(pending?' \u00b7 '+pending+' awaiting your reply':'');
  if(!all.length){$('#cyd-records').innerHTML='<div class="cyd-empty">No bookings on this device yet.</div>';return}
  $('#cyd-records').innerHTML='<table class="cyd-tbl"><thead><tr><th>When</th><th>Client</th><th>Contact</th><th>Session</th><th></th></tr></thead><tbody>'+
  all.map(function(r,i){return '<tr><td><b style="font-size:13px;letter-spacing:0;text-transform:none">'+esc(pretty(r.date))+'</b><div>'+esc(pretty12(r.time))+' \u2013 '+esc(pretty12(r.endTime||endTime(r.time,r.duration)))+'</div></td>'+
  '<td>'+esc(r.name)+'<div style="color:#3a3a3a;font-size:11px">'+esc(r.firsttime||'')+'</div></td>'+
  '<td>'+esc(r.email)+'<div>'+esc(r.phone||'')+'</div></td>'+
  '<td>'+esc(r.service)+'<div>'+esc(r.duration)+' min</div></td>'+
  '<td style="white-space:nowrap">'+(r.replied?'<button class="cyd-btn ghost sm" data-reply="'+i+'" title="Mark as awaiting reply">\u2713 Confirmed</button>':'<button class="cyd-btn sm" data-reply="'+i+'" title="Mark as confirmed">Needs reply</button>')+' <button class="cyd-btn ghost sm" data-mail="'+i+'">Email</button> <button class="cyd-btn ghost sm" data-ics="'+i+'">ICS</button> <button class="cyd-btn ghost sm" data-del="'+i+'">Delete</button></td></tr>'}).join('')+'</tbody></table>';
  $('#cyd-records').querySelectorAll('[data-reply]').forEach(function(bt){bt.addEventListener('click',function(){var all=load();all[+bt.dataset.reply].replied=!all[+bt.dataset.reply].replied;save(all);renderRecords()})});
  $('#cyd-records').querySelectorAll('[data-mail]').forEach(function(bt){bt.addEventListener('click',function(){
    var r=load()[+bt.dataset.mail];
    var L=['Hi '+(r.name||'')+',','','Confirming our session:','',pretty(r.date),pretty12(r.time)+' \u2013 '+pretty12(r.endTime||endTime(r.time,r.duration))+' '+(r.timezone||avail.tz),(r.service||'')+' \u2014 '+(r.duration||'')+' minutes','','\u2014 Vic'];
    window.location.href='mailto:'+encodeURIComponent(r.email||'')+'?subject='+encodeURIComponent('Confirming your session \u2014 '+pretty(r.date))+'&body='+encodeURIComponent(L.join('\n'));
  })});
  $('#cyd-records').querySelectorAll('[data-ics]').forEach(function(bt){bt.addEventListener('click',function(){var r=load()[+bt.dataset.ics];dl('cyd-session-'+slug(r.name)+'-'+r.date+'.ics',icsFor(r),'text/calendar')})});
  $('#cyd-records').querySelectorAll('[data-del]').forEach(function(bt){bt.addEventListener('click',function(){var all=load(),r=all[+bt.dataset.del];if(confirm('Delete the booking for '+r.name+' on '+pretty(r.date)+'?')){all.splice(+bt.dataset.del,1);save(all);renderRecords();render()}})});
}

function renderAvailEditor(){
  $('#cyd-availgrid').innerHTML=DOW.map(function(d,i){
    var bands=TIERS.filter(function(tier){return (avail.days[i]||[]).some(function(t){return tierFor(t).key===tier.key})});
    return '<div><label>'+d+'</label><input id="a_'+i+'" type="text" value="'+esc((avail.days[i]||[]).join(', '))+'" placeholder="closed">'+
      '<div style="display:flex;gap:5px;margin-top:5px;min-height:8px">'+bands.map(function(tier){return '<s style="display:block;width:16px;height:6px;background:'+tier.color+'"></s>'}).join('')+'</div></div>';
  }).join('');
  $('#s_blocked').value=(avail.blocked||[]).join(', ');
  $('#s_tz').value=avail.tz||'';
}
on('#cyd-avail','click',function(){
  var s=$('#cyd-settings');s.classList.toggle('cyd-hide');
  if(!s.classList.contains('cyd-hide'))renderAvailEditor();
});
on('#cyd-save-avail','click',function(){
  var days={};
  for(var i=0;i<7;i++){
    days[i]=($('#a_'+i).value||'').split(',').map(function(t){return t.trim()})
      .filter(function(t){return /^\d{1,2}:\d{2}$/.test(t)})
      .map(function(t){var p=t.split(':');return pad(+p[0])+':'+p[1]})
      .sort();
  }
  avail.days=days;
  avail.blocked=($('#s_blocked').value||'').split(',').map(function(t){return t.trim()}).filter(function(t){return /^\d{4}-\d{2}-\d{2}$/.test(t)});
  avail.tz=$('#s_tz').value.trim()||'Eastern Time (ET)';
  try{localStorage.setItem(AKEY,JSON.stringify(avail))}catch(e){alert('Could not save: '+e.message)}
  $('#cyd-saved').textContent='Saved.';setTimeout(function(){$('#cyd-saved').textContent=''},2500);
  render();
});
on('#cyd-advisor','click',function(){adm.classList.toggle('cyd-hide');if(!adm.classList.contains('cyd-hide'))renderRecords()});
on('#cyd-close','click',function(){adm.classList.add('cyd-hide')});
on('#cyd-db','click',function(){
  var all=load();
  if(!all.length)return alert('No bookings to compile yet.');
  dl('cyd-bookings-'+YEAR+'-'+new Date().toISOString().slice(0,10)+'.json',JSON.stringify({
    database:'Choose Your Destiny \u2014 '+YEAR+' bookings',
    generatedAt:new Date().toISOString(),
    bookingCount:all.length,
    timezone:avail.tz,
    availability:avail,
    bookings:all
  },null,2));
});
on('#cyd-csv','click',function(){
  var all=load();if(!all.length)return alert('No bookings to export.');
  var cols=['id','createdAt','date','time','endTime','timezone','tier','tierLabel','duration','service','fee','book','name','email','phone','firsttime','notes','status','replied'];
  function cell(v){if(v===true)v='yes';if(v===false)v='no';v=String(v==null?'':v);return '"'+v.replace(/"/g,'""')+'"'}
  dl('cyd-bookings-'+YEAR+'-'+new Date().toISOString().slice(0,10)+'.csv',
    '\ufeff'+cols.join(',')+'\r\n'+all.map(function(r){return cols.map(function(c){return cell(r[c])}).join(',')}).join('\r\n'),'text/csv');
});
on('#cyd-import','click',function(){$('#cyd-file').click()});
on('#cyd-file','change',function(e){
  var f=e.target.files[0];if(!f)return;var rd=new FileReader();
  rd.onload=function(){try{
    var v=JSON.parse(rd.result),inc=Array.isArray(v)?v:(v.bookings||[v]),all=load(),seen={};
    all.forEach(function(x){seen[x.id]=1});
    var added=0;inc.forEach(function(x){if(x&&x.id&&!seen[x.id]){all.push(x);added++}});
    all.sort(function(x,y){return (x.date+x.time).localeCompare(y.date+y.time)});
    save(all);renderRecords();render();alert('Imported '+added+' new booking'+(added===1?'':'s')+'.');
  }catch(err){alert('Could not read that file: '+err.message)}};
  rd.readAsText(f);e.target.value='';
});

/* pick up name and email handed over by the intake form */
(function(){
  try{
    var q=new URLSearchParams(location.search);
    if(q.get('name'))b.name=q.get('name');
    if(q.get('email'))b.email=q.get('email');
    if(q.get('phone'))b.phone=q.get('phone');
    if(!b.name&&!b.email){
      var p=JSON.parse(localStorage.getItem(PKEY)||'null');
      if(p){b.name=b.name||p.name;b.email=b.email||p.email;b.phone=b.phone||p.phone;if(p.service)b.service=b.service||p.service}
    }
    if(!b.firsttime&&(b.name||b.email))b.firsttime='This is my first session';
  }catch(e){}
})();

loadAvail();loadDraft();
if(step===4)step=0;
if(step>0&&!b.service)step=0;
render();
})();
</script>
{% endraw %}
